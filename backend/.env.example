# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Telegram
TELEGRAM_TOKEN=

# Public backend URL for the Telegram webhook.
# Leave empty on Render: RENDER_EXTERNAL_URL is used automatically.
WEBHOOK_BASE_URL=

# CORS - comma-separated frontend URLs (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Optional regex for extra origins, e.g. Vercel previews
CORS_ORIGIN_REGEX=

# Environment
ENVIRONMENT=development
DEBUG=true
